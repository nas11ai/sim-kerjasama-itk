# Staging QA (docs/qa/staging.md). Salin ke `.env` di checkout VM, lalu isi yang bertanda WAJIB.
# Berkas ini dibaca Laravel, Vite (saat build aset), dan Docker Compose sekaligus.

# WAJIB: alamat yang dibuka QA. Tanpa domain: IP publik VM + `.sslip.io`, mis. 152.67.10.20.sslip.io
SITE_HOST=
# Port 443 di VM. Hanya diubah saat menguji di laptop (mis. 8443); APP_URL lalu perlu ikut membawa port.
HTTP_PORT=80
HTTPS_PORT=443

# WAJIB: gerbang Basic Auth untuk seluruh situs (satu pasang untuk semua QA). Hash dibuat dengan
#   docker run --rm caddy:2 caddy hash-password --plaintext 'kata-sandi-gerbang'
# dan ditulis DI ANTARA PETIK TUNGGAL, karena hash berisi `$` yang kalau tidak akan dibaca sebagai variabel.
BASIC_AUTH_USER=qa
BASIC_AUTH_HASH=''

APP_NAME=SIMPAS
# `staging`, bukan `production`: QaDataSeeder menolak berjalan di production.
APP_ENV=staging
# Dibuat otomatis oleh deploy.sh saat kosong.
APP_KEY=
APP_DEBUG=false
APP_URL=https://${SITE_HOST}

# Kosong: Caddy meneruskan lewat FastCGI dengan IP klien asli, tanpa header X-Forwarded-*.
TRUSTED_PROXIES=

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=simpas
DB_USERNAME=simpas
# WAJIB: kata sandi acak; database tidak terbuka ke internet, tetapi jangan pakai contoh ini.
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=reverb
# Unggahan pribadi tetap di disk `local` (W15); satu host, jadi semua proses membaca berkas yang sama.
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Tidak ada email sungguhan di staging: isi email ditulis ke storage/logs/laravel.log.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@simpas.test"
MAIL_FROM_NAME="${APP_NAME}"

# WAJIB: ganti ketiganya dengan nilai acak (mis. `openssl rand -hex 16`).
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Alamat internal yang dipakai worker untuk menerbitkan siaran.
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# Alamat yang dibuka browser: lewat Caddy di port HTTPS, path /app.
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${SITE_HOST}"
VITE_REVERB_PORT="${HTTPS_PORT}"
VITE_REVERB_SCHEME=https

TELESCOPE_ENABLED=false
