APP_NAME=SIMPAS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# IP reverse proxy di depan aplikasi (dipisah koma, atau *). Kosong = tidak ada proxy:
# X-Forwarded-For diabaikan dan jejak audit mencatat IP koneksi langsung.
TRUSTED_PROXIES=

APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=simpas
DB_USERNAME=postgres
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=dragonfly
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=simpas
AWS_SECRET_ACCESS_KEY=simpas-secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=simpas-local
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true


# RT1 — Reverb (WebSocket). Nilai lokal; ganti ID/KEY/SECRET di produksi.
# Tanpa REVERB_APP_KEY, BROADCAST_CONNECTION=reverb membuat setiap request gagal saat boot.
REVERB_APP_ID=simpas-local
REVERB_APP_KEY=simpas-local-key
REVERB_APP_SECRET=simpas-local-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
# Host yang dicapai browser; bisa berbeda dari REVERB_HOST (alamat internal untuk server).
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
TELESCOPE_ENABLED=false
