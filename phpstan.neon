includes:
    - vendor/larastan/larastan/extension.neon
parameters:
    paths:
        - app
    level: 5

    # Mesin dev WSL 8 GB: bawaan phpstan = 1 worker per core (12 × s.d. 1G)
    # menghabiskan RAM dan membuat WSL crash (2026-11-08). Batasi.
    parallel:
        maximumNumberOfProcesses: 2
